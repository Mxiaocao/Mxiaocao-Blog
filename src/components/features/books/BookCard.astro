---
import { Icon } from "astro-icon/components";
import { bookStatusLabels, type Book } from "../../../data/books";

interface Props {
	book: Book;
}
const { book } = Astro.props;
const totalPages = Math.max(0, book.totalPages ?? 0);
const pagesRead = Math.max(0, book.pagesRead ?? 0);
const progress = totalPages > 0 ? Math.min(100, (pagesRead / totalPages) * 100) : 0;
---

<article class="book-card rounded-xl border border-black/10 dark:border-white/10 p-5" data-status={book.status}>
	<div class="flex gap-4 items-start">
		<div class="w-20 shrink-0 aspect-[2/3] rounded-lg overflow-hidden bg-(--btn-regular-bg) flex items-center justify-center">
			{book.cover ? (
				<img src={book.cover} alt={`${book.title}封面`} width="160" height="240" loading="lazy" class="w-full h-full object-cover" />
			) : (
				<Icon name="material-symbols:menu-book" class="text-3xl text-(--primary)" />
			)}
		</div>
		<div class="min-w-0 flex-1">
			<span class="text-sm text-(--primary)">{bookStatusLabels[book.status]}</span>
			<h2 class="text-lg font-bold text-black/90 dark:text-white/90 break-words mt-1">{book.title}</h2>
			<p class="text-sm text-black/60 dark:text-white/60 mt-1">{book.author}</p>
			{(book.publisher || book.publishedYear) && <p class="text-xs text-black/50 dark:text-white/50 mt-2">{[book.publisher, book.publishedYear].filter(Boolean).join(" · ")}</p>}
		</div>
	</div>
	{book.description && <p class="mt-4 text-sm text-black/70 dark:text-white/70 whitespace-pre-line">{book.description}</p>}
	{book.rating !== undefined && <p class="mt-3 text-sm text-(--primary)">评分：{Math.min(10, Math.max(0, book.rating))} / 10</p>}
	{totalPages > 0 && (
		<div class="mt-4">
			<p class="text-xs text-black/50 dark:text-white/50 mb-2">已读 {Math.min(pagesRead, totalPages)} / {totalPages} 页</p>
			<progress value={progress} max="100" aria-label={`${book.title}阅读进度`} class="w-full h-2" />
		</div>
	)}
	{(book.startDate || book.endDate) && <p class="mt-3 text-xs text-black/50 dark:text-white/50">{[book.startDate && `开始：${book.startDate}`, book.endDate && `读完：${book.endDate}`].filter(Boolean).join(" · ")}</p>}
	{book.tags && book.tags.length > 0 && <div class="flex flex-wrap gap-2 mt-3">{book.tags.map((tag) => <span class="text-xs rounded px-2 py-1 bg-(--btn-regular-bg) text-(--btn-content)">{tag}</span>)}</div>}
	{book.link && <a href={book.link} target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-sm text-(--primary) hover:underline">书籍详情 ↗</a>}
</article>

<style>
	.book-card.filtered-out { display: none; }
	progress { accent-color: var(--primary); }
</style>
