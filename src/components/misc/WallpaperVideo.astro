---
interface Props {
	src: string;
	poster?: string;
}

const { src, poster } = Astro.props;
---

<wallpaper-video class="absolute inset-0 block bg-black">
	<video
		class="h-full w-full"
		style="object-fit: var(--wallpaper-video-fit, contain); object-position: var(--wallpaper-video-position, center);"
		data-src={src}
		poster={poster}
		muted
		loop
		playsinline
		preload="none"
		aria-hidden="true"
	></video>
</wallpaper-video>

<script>
	class WallpaperVideo extends HTMLElement {
		private observer?: IntersectionObserver;
		private visible = false;
		private ready = false;
		private idleId?: number;
		private timer?: number;

		private allowPlayback = () => {
			this.ready = true;
			this.syncPlayback();
		};

		private schedulePlayback = () => {
			// Give the article a head start without waiting for slow third-party widgets.
			this.timer = window.setTimeout(() => {
				if ("requestIdleCallback" in window) {
					this.idleId = window.requestIdleCallback(this.allowPlayback, { timeout: 2000 });
				} else {
					this.allowPlayback();
				}
			}, 1500);
		};

		private syncPlayback = () => {
			const video = this.querySelector("video");
			if (!video) return;
			video.muted = true;
			if (this.ready && this.visible && !document.hidden && this.isConnected) {
				if (!video.hasAttribute("src") && video.dataset.src) {
					video.src = video.dataset.src;
				}
				void video.play().catch(() => {
					// Keep the poster visible if the browser blocks autoplay.
				});
			} else {
				video.pause();
			}
		};

		connectedCallback() {
			if (document.readyState !== "loading") this.schedulePlayback();
			else document.addEventListener("DOMContentLoaded", this.schedulePlayback, { once: true });
			this.observer = new IntersectionObserver(([entry]) => {
				this.visible = entry.isIntersecting;
				this.syncPlayback();
			});
			this.observer.observe(this);
			document.addEventListener("visibilitychange", this.syncPlayback);
		}

		disconnectedCallback() {
			document.removeEventListener("DOMContentLoaded", this.schedulePlayback);
			if (this.idleId !== undefined) window.cancelIdleCallback(this.idleId);
			window.clearTimeout(this.timer);
			this.ready = false;
			this.visible = false;
			this.observer?.disconnect();
			document.removeEventListener("visibilitychange", this.syncPlayback);
			const video = this.querySelector("video");
			if (video?.hasAttribute("src")) {
				video.pause();
				video.removeAttribute("src");
				video.load();
			}
		}
	}

	if (!customElements.get("wallpaper-video")) {
		customElements.define("wallpaper-video", WallpaperVideo);
	}
</script>
